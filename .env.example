# Microsoft Entra ID tenant (found in Azure Portal > Overview)
TENANT_ID=

# Application (client) ID from your App Registration
CLIENT_ID=

# Client secret from App Registration > Certificates & Secrets
CLIENT_SECRET=

# Comma-separated list of allowed CORS origins (default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,https://myapp.azurewebsites.net

# Enable Strict-Transport-Security header (set to true behind HTTPS in production)
# ENFORCE_HTTPS=false

# Vite-exposed variables (must be prefixed VITE_ to reach the browser bundle)
VITE_TENANT_ID=
VITE_CLIENT_ID=
